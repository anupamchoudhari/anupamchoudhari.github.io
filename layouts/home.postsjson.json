{{- $posts := slice -}}
{{- range first 20 (where site.RegularPages "Section" "in" (slice "workbench" "toolkit" "three-takeaways" "mildly-annoying" "parents-corner" "currently-brewing")).ByDate.Reverse -}}
{{- $posts = $posts | append (dict "title" .Title "link" .Permalink "description" (.Description | default .Params.blurb | default "") "date" (.Date.Format "2006-01-02T15:04:05Z07:00") "section" .CurrentSection.Title) -}}
{{- end -}}
{{- dict "posts" $posts | jsonify (dict "indent" "  ") -}}
